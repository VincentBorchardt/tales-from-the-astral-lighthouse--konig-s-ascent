;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tales from the Astral Lighthouse: Konig's Ascent"
run/main_scene="uid://dmcs8wneaddpk"
config/features=PackedStringArray("4.7", "GL Compatibility")
